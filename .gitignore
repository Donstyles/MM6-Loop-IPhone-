node_modules/
dist/
shots/
.vite/
*.log
.DS_Store

# Scratch capture scripts. Every agent writing a screenshot check drops one of
# these; they are named per-task and deleted when that task is done, so they
# should never be committed.
tools/scripts/_*.mjs

# Per-agent scratch: a private capture server config and one-off dump scripts.
# Several agents work this tree at once, so each spins up its own server on its
# own port rather than fighting over the shared one.
vite.*.config.js
!vite.config.js
!vite.capture.config.js
!vite.single.config.js
tools/_*.mjs
tools/mycap.sh
.mkshot.sh
dist-single/
build/
